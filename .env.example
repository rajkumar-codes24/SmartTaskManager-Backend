# SmartTaskManager — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit real credentials to version control.

# ============================================================
# REQUIRED — Database Connection
# ============================================================

# MySQL JDBC connection URL
DB_URL=jdbc:mysql://localhost:3306/smart_task_manager?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL username
DB_USERNAME=root

# MySQL password
DB_PASSWORD=your_mysql_password_here

# ============================================================
# REQUIRED — JWT Authentication
# ============================================================

# HMAC-SHA256 signing key (generate with: openssl rand -hex 64)
JWT_SECRET=your_64_byte_hex_string_here

# ============================================================
# REQUIRED — SMTP Email Configuration
# ============================================================

# SMTP server host (e.g., smtp.gmail.com for Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username (your email address)
SMTP_USERNAME=your_email@gmail.com

# SMTP password (use app password for Gmail, not your account password)
SMTP_PASSWORD=your_smtp_app_password

# Sender email address (can be same as SMTP username)
MAIL_FROM=noreply@smarttaskmanager.com

# ============================================================
# OPTIONAL — JWT Token Expiration (milliseconds)
# ============================================================

# Access token lifetime (default: 15 minutes = 900000ms)
JWT_ACCESS_EXPIRATION_MS=900000

# Refresh token lifetime (default: 7 days = 604800000ms)
JWT_REFRESH_EXPIRATION_MS=604800000

# Email verification token lifetime (default: 24 hours = 86400000ms)
JWT_VERIFICATION_EXPIRATION_MS=86400000

# Password reset token lifetime (default: 1 hour = 3600000ms)
JWT_RESET_EXPIRATION_MS=3600000

# ============================================================
# OPTIONAL — Application Configuration
# ============================================================

# Sender display name for emails
MAIL_FROM_NAME=Smart Task Manager

# Public base URL for backend API (used for email verification links)
# For local development: http://localhost:9999
# For production: https://your-backend-domain.com
APP_PUBLIC_BASE_URL=http://localhost:9999

# Frontend base URL for email links (password reset, etc.)
# The password reset email link opens this URL, not the backend API directly.
# For local React development: http://localhost:3000
# For production: https://your-frontend-domain.com
APP_FRONTEND_BASE_URL=http://localhost:3000

# CORS allowed origins (comma-separated)
# For React frontend on localhost:3000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================
# OPTIONAL — Reminder Scheduler
# ============================================================

# Scheduler polling interval in milliseconds (default: 30 seconds)
REMINDER_SCHEDULER_INTERVAL_MS=30000

# Initial delay before first scheduler run (default: 5 seconds)
REMINDER_INITIAL_DELAY_MS=5000

# Maximum reminders processed per batch (default: 50)
REMINDER_MAX_BATCH_SIZE=50

# Maximum retry attempts for failed email delivery (default: 3)
REMINDER_MAX_RETRIES=3

# ============================================================
# OPTIONAL — AI Task Capture
# ============================================================

# AI provider: "openai" or "rulebased" (default: rulebased)
AI_PROVIDER=rulebased

# OpenAI API key (required only if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# OPTIONAL — Production / Debug Settings
# ============================================================

# Enable Flyway migrations (default: true)
FLYWAY_ENABLED=true

# Hibernate DDL mode (default: validate — DO NOT change to create/create-drop in production)
HIBERNATE_DDL_AUTO=validate

# Log SQL queries (default: false — enable for debugging only)
SHOW_SQL=false

# ============================================================
# DEPLOYMENT NOTES
# ============================================================
#
# 1. Generate a strong JWT secret:
#    openssl rand -hex 64
#
# 2. For Gmail SMTP, use an App Password:
#    - Enable 2FA on your Google account
#    - Go to https://myaccount.google.com/apppasswords
#    - Generate an app password for "Mail"
#
# 3. For production, set APP_CORS_ORIGINS to your frontend domain:
#    APP_CORS_ORIGINS=https://your-frontend-domain.com
#
# 4. Never commit this file with real credentials.
#    Add it to .gitignore if storing locally.
#
